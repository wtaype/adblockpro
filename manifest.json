{
  "manifest_version": 3,
  "name": "AdBlock Pro",
  "description": "Bloqueador de anuncios liviano, silencioso y enfocado en privacidad.",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": [
    "declarativeNetRequest",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "main/servicio.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/logo16x16.png",
    "32": "assets/icons/logo32x32.png",
    "48": "assets/icons/logo48x48.png",
    "128": "assets/icons/logo128x128.png"
  },
  "action": {
    "default_title": "AdBlock Pro",
    "default_popup": "main/popup.html",
    "default_icon": {
      "16": "assets/icons/logo16x16.png",
      "32": "assets/icons/logo32x32.png",
      "48": "assets/icons/logo48x48.png",
      "128": "assets/icons/logo128x128.png"
    }
  },
  "options_page": "main/opciones.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "reglas_base",
        "enabled": true,
        "path": "main/reglas.json"
      }
    ]
  }
}
